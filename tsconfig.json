{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"isolatedDeclarations": false,
		"noEmit": true,
		// Hono's WebSocket types name DOM types that Node lacks.
		"skipLibCheck": true
	},
	"include": [
		"*.config.ts",
		"bench/**/*.ts",
		"scripts/**/*.ts",
		"packages/*/src/**/*.ts"
	],
	"exclude": ["bench/compare", "bench/typing/gen", "bench/typing/prototype"]
}
