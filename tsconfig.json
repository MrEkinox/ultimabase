{
	"extends": "./tooling/tsconfig/base.json",
	"compilerOptions": {
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"isolatedDeclarations": false,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": [
		"*.config.ts",
		"packages/*/*.config.ts",
		"tooling/**/*.config.ts"
	],
	"references": [
		{ "path": "./packages/shared" },
		{ "path": "./packages/core" },
		{ "path": "./packages/plugin-kit" },
		{ "path": "./packages/typegen" },
		{ "path": "./packages/pg-vector-plugin" },
		{ "path": "./packages/roles-plugin" },
		{ "path": "./packages/acl-permissions-plugin" },
		{ "path": "./packages/acl-postgres-plugin" },
		{ "path": "./packages/postgres-plugin" },
		{ "path": "./packages/testing" }
	]
}
