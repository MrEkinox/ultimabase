{
	"extends": "../../tooling/tsconfig/base.json",
	"compilerOptions": {
		"allowJs": true,
		"allowImportingTsExtensions": true,
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"incremental": true,
		"isolatedDeclarations": false,
		"jsx": "preserve",
		"lib": ["DOM", "DOM.Iterable", "ES2024"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"plugins": [{ "name": "next" }],
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		".source/**/*.ts"
	],
	"exclude": ["node_modules"]
}
