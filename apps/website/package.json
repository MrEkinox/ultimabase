{
	"name": "@ultimabase/website",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "yarn generate && next build --webpack",
		"build:public": "ULTIMABASE_PUBLIC_BUILD=1 yarn build",
		"dev": "next dev --webpack",
		"generate": "fumadocs-mdx",
		"lint": "yarn generate && eslint .",
		"postinstall": "fumadocs-mdx",
		"start": "next start",
		"test:browser": "yarn build && vitest run --config ../../vitest.config.ts --project website-browser",
		"validate:docs": "yarn generate && vitest run --config ../../vitest.config.ts --project website-content",
		"typecheck": "yarn generate && tsc --noEmit"
	},
	"dependencies": {
		"beautiful-mermaid": "1.1.3",
		"fumadocs-core": "16.15.12",
		"fumadocs-mdx": "15.4.3",
		"fumadocs-twoslash": "3.3.1",
		"fumadocs-ui": "16.15.12",
		"lucide-react": "1.47.0",
		"next": "16.4.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"shiki": "4.4.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@tailwindcss/postcss": "4.3.3",
		"@types/mdx": "2.0.14",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"github-slugger": "2.0.0",
		"playwright": "1.63.0",
		"playwright-core": "1.63.0",
		"tailwindcss": "4.3.3",
		"twoslash": "0.3.9",
		"typescript": "^6.0.3",
		"vitest": "4.1.11",
		"zod": "4.6.5"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
