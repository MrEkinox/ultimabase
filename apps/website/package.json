		"fumadocs-mdx": "15.4.0",
		"fumadocs-ui": "16.15.10",
		"next": "16.3.5",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "4.3.3",
		"@types/mdx": "2.0.13",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"tailwindcss": "4.3.3"
	},
	"engines": {
		"node": ">=24.0.0"
	}
