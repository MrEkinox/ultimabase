{
	"name": "ultimabase-repository",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"packageManager": "yarn@4.18.1",
	"engines": {
		"node": ">=24.7.0"
	},
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"scripts": {
		"budgets": "node scripts/check-budgets.ts",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"lint": "oxlint",
		"test": "vitest run --project unit --coverage --passWithNoTests",
		"test:packed": "node scripts/test-packed.ts",
		"test:postgres": "COVERAGE=postgres vitest run --project postgres --coverage --passWithNoTests",
		"typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.declarations.json && tsc --project bench/typing && tsc --project bench/typing/tsconfig.loose.json && tsc --project packages && tsc --project examples/password-sign-in && tsc --project packages/create-ultimabase/template --types node",
		"validate": "yarn format:check && yarn typecheck && yarn lint && yarn budgets && yarn test"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/pg": "8.23.1",
		"@types/semver": "7.8.0",
		"@vitest/coverage-v8": "5.0.5",
		"oxlint": "1.88.0",
		"oxlint-tsgolint": "7.0.2004",
		"pg": "8.23.1",
		"prettier": "^3.6.2",
		"semver": "7.8.5",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.5",
		"zod": "4.6.5"
	}
}
