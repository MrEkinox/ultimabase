{
	"name": "ultimabase",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"packageManager": "yarn@4.9.2",
	"engines": {
		"node": ">=24.0.0"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"lint": "eslint .",
		"test": "vitest run --passWithNoTests",
		"typecheck": "tsc --project tsconfig.json",
		"validate": "yarn format:check && yarn typecheck && yarn lint && yarn test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.0.0",
		"eslint": "^10.7.0",
		"jiti": "^2.6.1",
		"prettier": "^3.6.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "8.65.0",
		"vitest": "4.1.11"
	}
}
