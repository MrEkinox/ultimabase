{
	"name": "ultimabase",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"packageManager": "yarn@4.9.2",
	"engines": {
		"node": ">=24.0.0"
	},
	"workspaces": [
		"apps/*",
		"examples/*",
		"packages/*",
		"tooling/*"
	],
	"scripts": {
		"build": "yarn workspaces foreach --all --topological --no-private run build",
		"changeset": "changeset",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"lint": "yarn lint:core && yarn lint:packages && yarn lint:workspace",
		"lint:core": "eslint packages/core",
		"lint:packages": "eslint packages --ignore-pattern 'packages/core/**'",
		"lint:workspace": "eslint apps examples tests tooling eslint.config.ts tsdown.config.ts vitest.config.ts --no-error-on-unmatched-pattern",
		"release:publish": "yarn test:all && changeset publish",
		"test": "vitest run --project unit --project types",
		"test:all": "yarn test && yarn test:e2e",
		"test:coverage": "vitest run --project unit --project types --coverage",
		"test:e2e": "yarn build && yarn test:e2e:built",
		"test:e2e:built": "vitest run --project e2e --project postgres-e2e --passWithNoTests",
		"test:pack": "yarn build && yarn test:pack:built",
		"test:pack:built": "vitest run --project e2e tests/e2e/package-archives.e2e.test.ts tests/e2e/core-field-builder.e2e.test.ts tests/e2e/pg-vector-field-builder.e2e.test.ts tests/e2e/codegen-generated-types.e2e.test.ts tests/e2e/core-schema-targets.e2e.test.ts",
		"test:types": "vitest run --project types",
		"test:watch": "vitest --project unit --watch",
		"typecheck": "tsc --build tsconfig.json tooling/tsconfig/test.json"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@changesets/cli": "^2.29.7",
		"@eslint/js": "^10.0.1",
		"@publint/pack": "^0.1.6",
		"@testcontainers/postgresql": "^12.0.4",
		"@types/node": "^24.0.0",
		"@vitest/coverage-v8": "4.1.10",
		"eslint": "^10.7.0",
		"jiti": "^2.6.1",
		"prettier": "^3.6.2",
		"publint": "^0.3.22",
		"tsdown": "^0.22.14",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vitest": "4.1.10"
	}
}
