{
	"name": "@ultimabase/postgres",
	"version": "0.2.0",
	"description": "The PostgreSQL adapter for UltimaBase.",
	"type": "module",
	"license": "Apache-2.0",
	"homepage": "https://ultimabase.dev/docs/postgres",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MrEkinox/ultimabase.git",
		"directory": "packages/postgres"
	},
	"engines": {
		"node": ">=24.7.0"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/test"
	],
	"scripts": {
		"prepack": "rm -rf dist && yarn run -T tsc --project tsconfig.build.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js"
		}
	},
	"dependencies": {
		"kysely": "0.29.6",
		"pg": "8.23.1",
		"pg-connection-string": "2.14.1"
	},
	"peerDependencies": {
		"ultimabase": "^0.2.0"
	},
	"devDependencies": {
		"@types/pg": "8.23.1",
		"@ultimabase/testing": "workspace:*",
		"ultimabase": "workspace:*",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	}
}
