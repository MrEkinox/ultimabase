{
	"name": "@ultimabase/http",
	"version": "0.1.1",
	"description": "An HTTP server for UltimaBase: Hono routes that read the caller, CORS and a body limit.",
	"type": "module",
	"license": "Apache-2.0",
	"homepage": "https://ultimabase.dev/docs/http",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MrEkinox/ultimabase.git",
		"directory": "packages/http"
	},
	"engines": {
		"node": ">=24.7.0"
	},
	"exports": {
		".": "./src/index.ts",
		"./internal": "./src/internal.ts"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/test"
	],
	"scripts": {
		"prepack": "rm -rf dist && yarn run -T tsc --project tsconfig.build.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js",
			"./internal": "./dist/internal.js"
		}
	},
	"dependencies": {
		"@hono/node-server": "2.1.3",
		"hono": "4.13.13"
	},
	"peerDependencies": {
		"ultimabase": "^0.1.1"
	},
	"devDependencies": {
		"ultimabase": "workspace:*",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	}
}
