{
	"name": "@ultimabase/testing",
	"version": "0.0.0",
	"private": true,
	"description": "Test helpers for UltimaBase applications, plugins and adapters.",
	"type": "module",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=24.7.0"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/test"
	],
	"scripts": {
		"prepack": "rm -rf dist && yarn run -T tsc --project tsconfig.build.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"ultimabase": "^0.0.0",
		"vitest": "^5.0.5"
	},
	"devDependencies": {
		"@ultimabase/http": "workspace:*",
		"ultimabase": "workspace:*",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	}
}
