{
	"name": "@ultimabase/testing",
	"version": "0.0.0",
	"type": "module",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MrEkinox/ultimadatabase.git",
		"directory": "packages/testing"
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./plugins": {
			"types": "./dist/plugins.d.ts",
			"import": "./dist/plugins.js"
		},
		"./vitest": {
			"types": "./dist/vitest.d.ts",
			"import": "./dist/vitest.js"
		}
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run --project unit --project types --passWithNoTests",
		"typecheck": "tsc --build",
		"test:unit": "vitest run --project unit --passWithNoTests",
		"test:types": "vitest run --project types --passWithNoTests",
		"test:e2e:built": "vitest run --project e2e --project postgres-e2e --passWithNoTests",
		"typecheck:tests": "tsc --project tsconfig.test.json"
	},
	"dependencies": {
		"@testcontainers/postgresql": "^12.0.4",
		"@ultimabase/core": "workspace:^",
		"@ultimabase/shared": "workspace:^",
		"pg": "^8.16.3"
	},
	"devDependencies": {
		"@types/pg": "^8.15.5",
		"tsdown": "^0.22.14",
		"typescript": "^6.0.3",
		"vitest": "4.1.11"
	},
	"peerDependencies": {
		"vitest": "^4.1.11"
	},
	"peerDependenciesMeta": {
		"vitest": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
