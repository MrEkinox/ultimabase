{
	"name": "@ultimabase/graphql",
	"version": "0.1.0",
	"description": "GraphQL for UltimaBase: a Relay schema generated from the models, served by the HTTP plugin.",
	"type": "module",
	"license": "Apache-2.0",
	"homepage": "https://ultimabase.dev/docs/graphql",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MrEkinox/ultimabase.git",
		"directory": "packages/graphql"
	},
	"engines": {
		"node": ">=24.7.0"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/test"
	],
	"scripts": {
		"prepack": "rm -rf dist && yarn run -T tsc --project tsconfig.build.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js"
		}
	},
	"dependencies": {
		"graphql-http": "1.23.1",
		"graphql-ws": "6.4.1",
		"ws": "8.22.0"
	},
	"peerDependencies": {
		"@ultimabase/http": "^0.1.0",
		"@ultimabase/realtime": "^0.1.0",
		"graphql": "^17.0.2",
		"ultimabase": "^0.1.0"
	},
	"peerDependenciesMeta": {
		"@ultimabase/realtime": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/pg": "8.23.1",
		"@types/ws": "8.18.2",
		"@ultimabase/http": "workspace:*",
		"@ultimabase/postgres": "workspace:*",
		"@ultimabase/realtime": "workspace:*",
		"graphql": "17.0.2",
		"pg": "8.23.1",
		"ultimabase": "workspace:*",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	}
}
