{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"composite": false,
		"declarationMap": false,
		"noEmit": true,
		// Hono's WebSocket types, read through the HTTP plugin, name DOM types
		// that Node lacks.
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.test.ts", "src/**/test/**"]
}
