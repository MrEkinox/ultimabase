{
	"name": "ultimabase",
	"version": "0.1.1",
	"description": "The UltimaBase kernel and its in-memory adapter.",
	"type": "module",
	"license": "Apache-2.0",
	"homepage": "https://ultimabase.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MrEkinox/ultimabase.git",
		"directory": "packages/ultimabase"
	},
	"engines": {
		"node": ">=24.7.0"
	},
	"bin": "./src/cli.ts",
	"exports": {
		".": "./src/index.ts",
		"./internal": "./src/internal.ts"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/test"
	],
	"scripts": {
		"prepack": "rm -rf dist && yarn run -T tsc --project tsconfig.build.json"
	},
	"publishConfig": {
		"bin": "./dist/cli.js",
		"exports": {
			".": "./dist/index.js",
			"./internal": "./dist/internal.js"
		}
	},
	"dependencies": {
		"semver": "7.8.5"
	},
	"devDependencies": {
		"@ultimabase/testing": "workspace:*",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	}
}
