{
	"name": "@ultimabase/rest",
	"version": "0.0.0",
	"private": true,
	"description": "REST for UltimaBase: GraphQL's arguments and responses over resource routes, served by the HTTP plugin.",
	"type": "module",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=24.7.0"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/test"
	],
	"scripts": {
		"prepack": "rm -rf dist && yarn run -T tsc --project tsconfig.build.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"@ultimabase/http": "^0.0.0",
		"@ultimabase/realtime": "^0.0.0",
		"ultimabase": "^0.0.0"
	},
	"peerDependenciesMeta": {
		"@ultimabase/realtime": {
			"optional": true
		}
	},
	"devDependencies": {
		"@seriousme/openapi-schema-validator": "2.11.0",
		"@types/pg": "8.23.1",
		"@ultimabase/http": "workspace:*",
		"@ultimabase/postgres": "workspace:*",
		"@ultimabase/realtime": "workspace:*",
		"ajv": "8.20.0",
		"pg": "8.23.1",
		"ultimabase": "workspace:*",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	}
}
