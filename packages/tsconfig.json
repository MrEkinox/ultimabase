{
	// The production code of every package, in one program: each export has
	// a written type (D-70). The tests are the root project's.
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"composite": false,
		"declarationMap": false,
		"noEmit": true,
		// Hono's WebSocket types name DOM types that Node lacks.
		"skipLibCheck": true
	},
	"include": ["*/src/**/*.ts"],
	"exclude": ["*/src/**/*.test.ts", "*/src/**/test/**"]
}
