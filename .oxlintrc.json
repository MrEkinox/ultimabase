{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": [
		"eslint",
		"typescript",
		"unicorn",
		"oxc",
		"import",
		"node",
		"promise",
		"vitest"
	],
	"jsPlugins": ["./scripts/lint-plugin.ts"],
	"categories": {
		"correctness": "error",
		"suspicious": "error"
	},
	"options": {
		"denyWarnings": true,
		"reportUnusedDisableDirectives": "error",
		"typeAware": true
	},
	"ignorePatterns": [
		"**/coverage/**",
		"**/dist/**",
		"bench/compare/**",
		"bench/typing/gen/**",
		"website/.next/**",
		"website/.source/**",
		"website/out/**"
	],
	"rules": {
		"eslint/max-lines": ["error", { "max": 400 }],
		"eslint/no-underscore-dangle": ["error", { "allow": ["_count"] }],
		"eslint/no-warning-comments": [
			"error",
			{
				"terms": ["v8 ignore", "c8 ignore", "istanbul ignore"],
				"location": "anywhere"
			}
		],
		"typescript/await-thenable": "error",
		"typescript/ban-ts-comment": "error",
		"typescript/consistent-type-exports": "error",
		"typescript/consistent-type-imports": "error",
		"typescript/no-explicit-any": "error",
		"typescript/no-floating-promises": "error",
		"typescript/no-misused-promises": "error",
		"typescript/no-unsafe-argument": "error",
		"typescript/no-unsafe-assignment": "error",
		"typescript/no-unsafe-call": "error",
		"typescript/no-unsafe-member-access": "error",
		"typescript/no-unsafe-return": "error",
		"typescript/switch-exhaustiveness-check": "error"
	},
	"overrides": [
		{
			"files": ["packages/*/src/**"],
			"rules": { "ultimabase/no-decision-in-string": "error" }
		},
		{
			"files": ["**/*.test.ts", "**/test/**"],
			"rules": {
				"eslint/max-lines": "off",
				"ultimabase/no-decision-in-string": "off"
			}
		}
	]
}
