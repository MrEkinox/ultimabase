{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "../tooling/tsconfig/test.json",
	// Keep root E2E files in an explicit editor project so contextual schema types remain available.
	// The ACL option declaration below is a global augmentation that the complete
	// test program already includes; affected CI runs check this project alone.
	"include": [
		"./e2e/**/*.ts",
		"./fixtures/**/*.ts",
		"./performance/**/*.ts",
		"../packages/acl-permissions-plugin/src/acl-option.test-support.ts"
	]
}
