{
	// Its own program, as an application is.
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"isolatedDeclarations": false,
		"noEmit": true,
		// The browser's page and its service worker, beside the server.
		"lib": ["ES2024", "ESNext.Disposable", "DOM", "DOM.Iterable", "WebWorker"],
		// Hono's WebSocket types name DOM types that Node lacks.
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"]
}
