{
	// Its own program: an application declares its user model once (D-62).
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"isolatedDeclarations": false,
		"noEmit": true,
		// Hono's WebSocket types name DOM types that Node lacks.
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"]
}
