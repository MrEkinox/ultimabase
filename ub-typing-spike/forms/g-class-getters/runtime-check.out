TodoUser (App.PasswordUserSchema)
  fields: displayName, assignedTodos, roles, username, email, id, createdAt, updatedAt, acl
  shape:  {}
  rules:  {"access":["read","update"],"hooks":["fields"]}
TodoRole (App.RoleSchema)
  fields: description, name, members, id, createdAt, updatedAt, acl
  shape:  {}
  rules:  {"access":["read","create"]}
Todo
  fields: title, archived, priority, allowedPriorities, status, dueAt, assignee, parent, subtasks, tags, id, createdAt, updatedAt, acl, isDeleted
  shape:  {"softDelete":true,"postgres":{"table":"todos","indexes":[{"fields":["archived","dueAt"]}]}}
  rules:  {"access":["read","update","delete","create"],"acl":["default"],"hooks":["beforeUpdate","beforeCreate"]}
Tag
  fields: name, todos, id, createdAt, updatedAt, acl
  shape:  {}
  rules:  {"access":["read","delete"]}

Todo targets: assignee -> TodoUser, parent -> Todo, subtasks -> Todo, tags -> Tag
TodoRole.members -> TodoUser

Todo.access.read.where(builder) -> [["eq","archived",false]]
